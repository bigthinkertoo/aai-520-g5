    "# Owner: Student 2 — Jim McCarthy: orchestration\n",
    "# Student 2: orchestrate retrieval, Student 3 analysis/revision, and persistent memory.\n",
    "class ResearchAgent:\n",
    "    # Constructor to initialize the ResearchAgent with the necessary components and configurations.\n",
    "    def __init__(\n",
    "        self,\n",
    "        api,\n",
    "        *,\n",
    "        live=False,\n",
    "        memory_path=MEMORY_PATH,\n",
    "        output_dir=OUTPUT_DIR,\n",
    "        analyst=analyze_packet,\n",
    "        evaluator=evaluate_research,\n",
    "        reporter=build_report,\n",
    "        max_passes=2,\n",
    "    ):\n",
    "        self.api, self.live = api, live\n",
    "        self.memory_path, self.output_dir = Path(memory_path), Path(output_dir)\n",
    "        self.analyst, self.evaluator, self.reporter = (\n",
    "            analyst,\n",
    "            evaluator,\n",
    "            reporter,\n",
    "        )\n",
    "        self.max_passes = max(1, min(2, int(max_passes)))\n",
    "\n",
    "    # Define the main research agent function that orchestrates the research process.\n",
    "    def research_agent(\n",
    "        self, symbol: str, question: str = QUESTION, peers=None, sources=None\n",
    "    ) -> dict:\n",
    "        peers = list(peers or [])\n",
    "        if not all(\n",
    "            isinstance(p, str)\n",
    "            and re.fullmatch(r\"[A-Za-z0-9^][A-Za-z0-9.=^-]{0,11}\", p)\n",
    "            for p in peers\n",
    "        ):\n",
    "            raise ValueError(\"Peer tickers contain invalid characters\")\n",
    "        \n",
    "        # Validate the ticker symbol using the API and handle any validation errors.\n",
    "        check = self.api.validate_ticker(symbol)\n",
    "        if check[\"valid\"] is False:\n",
    "            raise ValueError(\n",
    "                f\"{check.get('note')} Suggestions: {check.get('suggestions', [])}\"\n",
    "            )\n",
    "        symbol = check[\"symbol\"]\n",
    "        memory = load_memory(self.memory_path)\n",
    "\n",
    "        # Retrieve the historical analysis attempts for the given symbol from memory.\n",
    "        history = memory[\"symbols\"].get(symbol, [])\n",
    "        llm_start = len(getattr(self.api, \"LLM_LOG\", []))\n",
    "\n",
    "        # Create a research plan based on the symbol, question, history, peers, and sources.\n",
    "        plan = create_research_plan(\n",
    "            self.api, symbol, question, history, peers, sources\n",
    "        )\n",
    "\n",
    "        # Generate a unique run ID for this research attempt using the current UTC timestamp and a random UUID.\n",
    "        run_id = (\n",
    "            datetime.now(timezone.utc).strftime(\"%Y%m%dT%H%M%S\")\n",
    "            + \"_\"\n",
    "            + uuid.uuid4().hex[:8]\n",
    "        )\n",
    "        # Initialize a list to store the results of each research attempt.\n",
    "        attempts = []\n",
    "\n",
    "        # Iterate through the maximum number of allowed passes to collect evidence, analyze it, and evaluate the results.\n",
    "        for index in range(self.max_passes):\n",
    "            # Collect the evidence bundle based on the research plan and route the content to the appropriate specialist roles.\n",
    "            bundle = collect_bundle(self.api, plan, self.live)\n",
    "\n",
    "            # Route the collected evidence to the appropriate specialist roles for analysis.\n",
    "            packets = route_content(bundle)\n",
    "\n",
    "            # Extract any lessons from the research plan to inform the analysis process.\n",
    "            lessons = plan.get(\"analysis_lessons\", [])\n",
    "            # Perform the analysis for each specialist role using the provided analyst function, \n",
    "            # passing in the role, packet, and any lessons learned.\n",
    "            analyses = {\n",
    "                role: self.analyst(\n",
    "                    role, copy.deepcopy(packet), lessons=lessons\n",
    "                )\n",
    "                for role, packet in packets.items()\n",
    "            }\n",
    "\n",
    "            # Validate the evaluation of the analyses using the provided evaluator function, and store the results.\n",
    "            evaluation = validate_evaluation(\n",
    "                self.evaluator(bundle, analyses, plan)\n",
    "            )\n",
    "            revisions = [\n",
    "                {\n",
    "                    \"draft\": 1,\n",
    "                    \"analyses\": copy.deepcopy(analyses),\n",
    "                    \"evaluation\": copy.deepcopy(evaluation),\n",
    "                }\n",
    "            ]\n",
    "\n",
    "            # If the evaluation indicates that revisions are needed, create a revised set of analyses based on \n",
    "            # the feedback provided by the evaluator.\n",
    "            if evaluation.get(\"needs_revision\"):\n",
    "                revised = copy.deepcopy(analyses)\n",
    "                for role, feedback in evaluation.get(\n",
    "                    \"analysis_feedback\", {}\n",
    "                ).items():\n",
    "                    revised[role] = self.analyst(\n",
    "                        role,\n",
    "                        copy.deepcopy(packets[role]),\n",
    "                        feedback=feedback,\n",
    "                        lessons=lessons,\n",
    "                    )\n",
    "                revised_eval = validate_evaluation(\n",
    "                    self.evaluator(bundle, revised, plan)\n",
    "                )\n",
    "                revisions.append(\n",
    "                    {\n",
    "                        \"draft\": 2,\n",
    "                        \"analyses\": copy.deepcopy(revised),\n",
    "                        \"evaluation\": copy.deepcopy(revised_eval),\n",
    "                    }\n",
    "                )\n",
    "                if revised_eval[\"score\"] >= evaluation[\"score\"]:\n",
    "                    analyses, evaluation = revised, revised_eval\n",
    "\n",
    "            # Store the results of this research attempt, including the analyses, evaluation, and any revisions made.\n",
    "            attempts.append(\n",
    "                {\n",
    "                    \"pass\": index + 1,\n",
    "                    \"plan\": copy.deepcopy(plan),\n",
    "                    \"bundle\": bundle,\n",
    "                    \"analyses\": analyses,\n",
    "                    \"evaluation\": evaluation,\n",
    "                    \"analysis_revisions\": revisions,\n",
    "                }\n",
    "            )\n",
    "            if (\n",
    "                not evaluation[\"retry_news\"]\n",
    "                or \"news\" not in plan[\"sources\"]\n",
    "                or plan[\"lookback_days\"] >= 30\n",
    "                or index + 1 == self.max_passes\n",
    "            ):\n",
    "                break\n",
    "            plan = {\n",
    "                **plan,\n",
    "                \"lookback_days\": 30,\n",
    "                \"reason\": \"Evaluator requested broader news coverage; bounded retry.\",\n",
    "            }\n",
    "\n",
    "        # Select the best attempt based on the evaluation score and prepare the final report and memory entry.\n",
    "        best = max(attempts, key=lambda a: a[\"evaluation\"][\"score\"])\n",
    "        bundle, evaluation = best[\"bundle\"], best[\"evaluation\"]\n",
    "\n",
    "        # Determine if the data used in this research attempt is synthetic or from sample sources.\n",
    "        synthetic = (not self.live) or bool(bundle[\"news\"].get(\"used_sample_data\"))\n",
    "\n",
    "        # Generate the final report using the provided reporter function or create a default handoff report \n",
    "        # if no reporter is specified.\n",
    "        report = (\n",
    "            self.reporter(bundle, best[\"analyses\"], evaluation)\n",
    "            if self.reporter\n",
    "            else {\n",
    "                \"kind\": \"student3_handoff\",\n",
    "                \"symbol\": symbol,\n",
    "                \"summary\": \"Evidence collected and routed; final analysis/report belongs to Student 3.\",\n",
    "                \"synthetic\": synthetic,\n",
    "                \"sources\": bundle[\"sources\"],\n",
    "                \"issues\": evaluation[\"issues\"],\n",
    "            }\n",
    "        )\n",
    "\n",
    "        # Combine any tool failures encountered during the research attempts with the evaluation issues to \n",
    "        # create a comprehensive list of issues for this research run.\n",
    "        tool_issues = [\n",
    "            f\"tool_failed:{r['tool']}\"\n",
    "            for a in attempts\n",
    "            for r in a[\"bundle\"][\"pipeline_meta\"][\"tool_trace\"]\n",
    "            if not r[\"ok\"]\n",
    "        ]\n",
    "\n",
    "        # Combine the evaluation issues and tool failures into a unique list of issues for this research run.\n",
    "        issues = list(dict.fromkeys(evaluation[\"issues\"] + tool_issues))\n",
    "        if check[\"valid\"] is None:\n",
    "            issues.append(\"ticker_unverified:\" + str(check.get(\"note\", \"\")))\n",
    "\n",
    "        # Determine if a broader news lookback window helped improve the evaluation score compared to the first \n",
    "        # attempt, and check if any of the attempts had thin news coverage.\n",
    "        broad_window_helped = (\n",
    "            best[\"plan\"][\"lookback_days\"] == 30\n",
    "            and best[\"evaluation\"][\"score\"]\n",
    "            > attempts[0][\"evaluation\"][\"score\"]\n",
    "        )\n",
    "\n",
    "        # Check if any of the attempts had thin news coverage that required a retry.\n",
    "        thin_any = any(a[\"evaluation\"][\"retry_news\"] for a in attempts)\n",
    "        reflection = reflect_on_run(attempts)\n",
    "        retained_lessons = list(\n",
    "            dict.fromkeys(\n",
    "                plan.get(\"analysis_lessons\", [])\n",
    "                + reflection[\"analysis_lessons\"]\n",
    "            )\n",
    "        )\n",
    "\n",
    "        # Prepare the memory entry for this research run, including the run ID, timestamp, mode, previous \n",
    "        # conclusions, news aggregate, issues encountered, next lookback days, reflection, and analysis lessons.\n",
    "        entry = {\n",
    "            \"run_id\": run_id,\n",
    "            \"timestamp\": utc_now(),\n",
    "            \"mode\": \"live\" if self.live else \"demo\",\n",
    "            \"previous_conclusions\": (\n",
    "                None\n",
    "                if synthetic\n",
    "                else bundle[\"news\"].get(\"digest\", {}).get(\"headline\")\n",
    "            ),\n",
    "            \"news_aggregate\": (\n",
    "                None if synthetic else bundle[\"news\"].get(\"aggregate\")\n",
    "            ),\n",
    "            \"issues_encountered\": issues,\n",
    "            \"next_lookback_days\": (\n",
    "                30\n",
    "                if broad_window_helped or thin_any\n",
    "                else best[\"plan\"][\"lookback_days\"]\n",
    "            ),\n",
    "            \"reflection\": reflection,\n",
    "            \"analysis_lessons\": retained_lessons,\n",
    "        }\n",
    "\n",
    "        # Save the final results of this research run to a JSON file in the output directory, including the \n",
    "        # schema version, run ID, symbol, mode, synthetic flag, validation check, selected pass, plan, bundle, \n",
    "        # analyses, evaluation, report, memory entry, attempts, and LLM log.\n",
    "        result = {\n",
    "            \"schema_version\": 1,\n",
    "            \"run_id\": run_id,\n",
    "            \"symbol\": symbol,\n",
    "            \"mode\": \"live\" if self.live else \"demo\",\n",
    "            \"synthetic\": synthetic,\n",
