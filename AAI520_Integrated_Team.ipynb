    "# Owner: Shared integration and validation\n",
    "\n",
    "# Provide a context manager to isolate the fixture pipeline for testing without affecting live state or memory.\n",
    "@contextmanager\n",
    "def isolated_fixture_pipeline(output_dir):\n",
    "    \"\"\"Exercise the actual pipeline without changing live state or memory.\"\"\"\n",
    "    global LIVE, LLM_ENABLED, TOOL_REGISTRY, CONFIG\n",
    "    saved = (\n",
    "        LIVE,\n",
    "        LLM_ENABLED,\n",
    "        TOOL_REGISTRY,\n",
    "        CONFIG,\n",
    "        LLM_LOG[:],\n",
    "        GATE_LOG[:],\n",
    "        CHAIN_TRACE[:],\n",
    "    )\n",
    "    LIVE, LLM_ENABLED = False, False\n",
    "    CONFIG = {\n",
    "        **CONFIG,\n",
    "        \"NEWS_LOOKBACK_DAYS\": 14,\n",
    "        \"OUTPUT_DIR\": str(output_dir),\n",
    "    }\n",
    "\n",
    "    # Override the tool registry with a controlled provider that can inject specific behaviors for testing.\n",
    "    def controlled_provider(name, **kwargs):\n",
    "        result = fixture_tool(name, **kwargs)\n",
    "        if name == \"get_price_history\" and result[\"ok\"]:\n",
    "            frame = result[\"data\"].copy()\n",
    "            close = np.concatenate(\n",
    "                [\n",
    "                    np.linspace(80, 120, len(frame) - 22),\n",
    "                    np.linspace(120, 100, 22),\n",
    "                ]\n",
    "            )\n",
    "            for key in (\"Open\", \"Close\"):\n",
    "                frame[key] = close\n",
    "            frame[\"High\"], frame[\"Low\"] = close + 1, close - 1\n",
    "            result[\"data\"] = frame\n",
    "        return result\n",
    "\n",
    "    # Override the tool registry with controlled providers for testing, allowing for intentional fault injection \n",
    "    # and controlled behavior during the research process.\n",
    "    TOOL_REGISTRY = {\n",
    "        name: {\n",
    "            **spec,\n",
    "            \"fn\": (\n",
    "                lambda _name=name, **kwargs: controlled_provider(\n",
    "                    _name, **kwargs\n",
    "                )\n",
    "            ),\n",
    "        }\n",
    "        for name, spec in REAL_TOOL_REGISTRY.items()\n",
    "    }\n",
    "\n",
    "    # Yield a shared pipeline instance for testing, ensuring that the original state is restored after the context is exited.\n",
    "    try:\n",
    "        yield SharedPipeline()\n",
    "    finally:\n",
    "        LIVE, LLM_ENABLED, TOOL_REGISTRY, CONFIG = saved[:4]\n",
    "        LLM_LOG[:] = saved[4]\n",
    "        GATE_LOG[:] = saved[5]\n",
    "        CHAIN_TRACE[:] = saved[6]\n",
    "\n",
    "# Provide a controlled draft function that can intentionally inject faults into the analysis process for testing purposes.\n",
    "def controlled_draft(role, packet, feedback=None, lessons=None):\n",
    "    # Intentional fault injection, not a claim about an actual LLM response.\n",
    "    # If the role is \"market\" and there is no feedback and the lesson \"include_monthly_return\" is not present,\n",
    "    # modify the analysis result to omit the monthly return and indicate positive momentum.\n",
    "    result = analyze_packet(role, packet, feedback=feedback, lessons=lessons)\n",
    "    \n",
    "    if (\n",
    "        role == \"market\"\n",
    "        and not feedback\n",
    "        and \"include_monthly_return\" not in (lessons or [])\n",
    "    ):\n",
    "        result[\"summary\"] = (\n",
    "            \"Momentum is positive; the monthly return was omitted.\"\n",
    "        )\n",
    "        result[\"momentum_direction\"] = \"positive\"\n",
    "        result[\"claims\"] = [\n",
    "            c\n",
    "            for c in result[\"claims\"]\n",
    "            if c[\"evidence_id\"] != \"market.price_summary.return_1m\"\n",
    "        ]\n",
    "        result[\"method\"] = \"controlled_flawed_fixture\"\n",
    "    return result\n",
    "\n",
    "# Run a series of workflow demonstrations to validate the research agent's behavior, including memory-informed \n",
    "# runs and controlled fault injection.\n",
    "def run_workflow_demonstrations():\n",
    "    with tempfile.TemporaryDirectory(dir=OUTPUT_DIR) as directory:\n",
    "        root = Path(directory)\n",
    "        with isolated_fixture_pipeline(root) as api:\n",
    "            test_agent = ResearchAgent(\n",
    "                api,\n",
    "                memory_path=root / \"memory.json\",\n",
    "                output_dir=root,\n",
    "                analyst=controlled_draft,\n",
    "            )\n",
    "            groups = {\n",
    "                \"news\",\n",
    "                \"prices\",\n",
    "                \"fundamentals\",\n",
    "                \"macro\",\n",
    "                \"sec\",\n",
    "                \"peers\",\n",
    "            }\n",
    "            before = test_agent.research_agent(\n",
    "                \"NVDA\", peers=[\"AMD\", \"INTC\"], sources=groups\n",
    "            )\n",
    "            after = test_agent.research_agent(\n",
    "                \"NVDA\", peers=[\"AMD\", \"INTC\"], sources=groups\n",
    "            )\n",
    "            initial = before[\"attempts\"][0][\"analysis_revisions\"]\n",
    "\n",
    "            # Verify that the initial analysis revisions contain two drafts, with the first draft needing \n",
    "            # revision and the second draft not needing revision. Also, check that the second draft has a \n",
    "            # higher evaluation score than the first draft and that the momentum direction is negative. \n",
    "            # Additionally, verify that the before state has two attempts and that the selected pass is 2, \n",
    "            # with a lookback of 30 days and the inclusion of monthly return in the analysis lessons. Finally, \n",
    "            # check that the after state has one attempt with one analysis revision, does not need revision, and \n",
    "            # that the previous conclusions are None, with a recommendation of \"NO RATING / SYNTHETIC DATA\".\n",
    "            assert len(initial) == 2\n",
    "            assert initial[0][\"evaluation\"][\"needs_revision\"]\n",
    "            assert not initial[1][\"evaluation\"][\"needs_revision\"]\n",
    "            assert (\n",
    "                initial[1][\"evaluation\"][\"score\"]\n",
    "                > initial[0][\"evaluation\"][\"score\"]\n",
    "            )\n",
    "            assert (\n",
    "                initial[1][\"analyses\"][\"market\"][\"momentum_direction\"]\n",
    "                == \"negative\"\n",
    "            )\n",
    "            assert (\n",
    "                len(before[\"attempts\"]) == 2 and before[\"selected_pass\"] == 2\n",
    "            )\n",
    "            assert before[\"plan\"][\"lookback_days\"] == 30\n",
    "            assert (\n",
    "                \"include_monthly_return\"\n",
    "                in before[\"memory_entry\"][\"analysis_lessons\"]\n",
    "            )\n",
    "            assert after[\"plan\"][\"previous_run_count\"] == 1\n",
    "            assert (\n",
    "                after[\"plan\"][\"analysis_lessons\"]\n",
    "                == before[\"memory_entry\"][\"analysis_lessons\"]\n",
    "            )\n",
    "            assert len(after[\"attempts\"]) == 1\n",
    "            assert len(after[\"attempts\"][0][\"analysis_revisions\"]) == 1\n",
    "            assert not after[\"evaluation\"][\"needs_revision\"]\n",
    "            assert before[\"memory_entry\"][\"previous_conclusions\"] is None\n",
    "            assert (\n",
    "                before[\"report\"][\"recommendation\"]\n",
    "                == \"NO RATING / SYNTHETIC DATA\"\n",
    "            )\n",
    "\n",
    "            # Contract boundaries independent of the fault-injection demo.\n",
    "            normal_agent = ResearchAgent(\n",
    "                api, memory_path=root / \"other_memory.json\", output_dir=root\n",
    "            )\n",
    "\n",
    "            # Verify that the research agent can handle different sources correctly, returning analyses \n",
    "            # for news and prices as expected. Also, check that the evaluation's numeric gate failure rate \n",
    "            # is None for price-only analyses. Additionally, test that calling an unknown tool returns a \n",
    "            # failure response and that invalid source plans or ticker symbols raise ValueErrors as expected. \n",
    "            # Finally, validate that the reasoning issues function correctly identifies claim value mismatches \n",
    "            # and unknown evidence references.\n",
    "            news_only = normal_agent.research_agent(\"NVDA\", sources={\"news\"})\n",
    "            assert set(news_only[\"analyses\"]) == {\"news\"}\n",
    "            assert news_only[\"bundle\"][\"news\"][\"aggregate\"][\n",
    "                \"n_articles\"\n",
    "            ] == len(news_only[\"bundle\"][\"news\"][\"articles\"])\n",
    "\n",
    "            # Verify that the research agent can handle different sources correctly, returning analyses for news \n",
    "            # and prices as expected. Also, check that the evaluation's numeric gate failure rate is None for \n",
    "            # price-only analyses. Additionally, test that calling an unknown tool returns a failure response \n",
    "            # and that invalid source plans or ticker symbols raise ValueErrors as expected. Finally, validate \n",
    "            # that the reasoning issues function correctly identifies claim value mismatches and unknown evidence \n",
    "            # references.\n",
    "            price_only = normal_agent.research_agent(\n",
    "                \"AAPL\", sources={\"prices\"}\n",
    "            )\n",
    "            assert set(price_only[\"analyses\"]) == {\"market\"}\n",
    "            assert (\n",
    "                price_only[\"evaluation\"][\"numeric_gate_failure_rate\"] is None\n",
    "            )\n",
    "            assert ToolManager(api).call(\"unknown\")[\"ok\"] is False\n",
    "\n",
    "            # Verify that the research agent raises ValueErrors for invalid source plans or ticker symbols, and that\n",
    "            # the reasoning issues function correctly identifies claim value mismatches and unknown evidence references.\n",
    "            for bad_sources in (set(), {\"unregistered_source\"}):\n",
    "                try:\n",
    "                    normal_agent.research_agent(\"NVDA\", sources=bad_sources)\n",
    "                except ValueError:\n",
    "                    pass\n",
    "                else:\n",
    "                    raise AssertionError(\"Invalid source plan accepted\")\n",
    "            try:\n",
    "                normal_agent.research_agent(\"!invalid\", sources={\"news\"})\n",
    "            except ValueError:\n",
    "                pass\n",
    "            else:\n",
    "                raise AssertionError(\"Invalid ticker accepted\")\n",
    "\n",
    "            # Verify that the reasoning issues function correctly identifies claim value mismatches and unknown \n",
    "            # evidence references.\n",
    "            packet = route_content(before[\"bundle\"])[\"market\"]\n",
    "            wrong_value = analyze_packet(\"market\", packet)\n",
    "            wrong_value[\"claims\"][0][\"value\"] = 999999\n",
    "            assert \"claim_value_mismatch\" in reasoning_issues(\n",
    "                \"market\", wrong_value, packet\n",
    "            )\n",
    "            unknown_ref = analyze_packet(\"market\", packet)\n",
    "            unknown_ref[\"claims\"][0][\"evidence_id\"] = \"invented.path\"\n",
    "            assert \"unknown_evidence_reference\" in reasoning_issues(\n",
    "                \"market\", unknown_ref, packet\n",
    "            )\n",
    "            unknown_ref[\"claims\"][0][\"evidence_id\"] = [\"malformed\", \"path\"]\n",
    "            assert \"unknown_evidence_reference\" in reasoning_issues(\n",
    "                \"market\", unknown_ref, packet\n",
    "            )\n",
    "            assert analysis_audit(before[\"bundle\"], {})[\"issues\"]\n",
    "            assert gate_summary(\n",
    "                \"Invented revenue $999999 billion\", \"Revenue $1 billion\"\n",
    "            )\n",
    "\n",
    "            # Verify the broader window reaches providers in actual tool arguments.\n",
    "            trace = before[\"bundle\"][\"pipeline_meta\"][\"tool_trace\"]\n",
    "            assert all(\n",
    "                t[\"arguments\"][\"days\"] == 30\n",
    "                for t in trace\n",
    "                if t[\"tool\"] in {\"fetch_news_newsapi\", \"fetch_news_google_rss\"}\n",
    "            )\n",
    "            saved = json.loads(\n",
    "                Path(before[\"output_path\"]).read_text(encoding=\"utf-8\")\n",
    "            )\n",
    "            assert saved[\"attempts\"][0][\"analysis_revisions\"][0][\"evaluation\"][\n",
    "                \"needs_revision\"\n",
    "            ]\n",
    "\n",
    "            # Provider exceptions become failures and are retained in run memory.\n",
    "            original_tool = api.call_tool\n",
    "            def broken_tool(*args, **kwargs):\n",
    "                raise RuntimeError(\"simulated provider failure\")\n",
    "            try:\n",
    "                api.call_tool = broken_tool\n",
    "                assert ToolManager(api).call(\"get_price_history\")[\"ok\"] is False\n",
    "                failed_run = normal_agent.research_agent(\"MSFT\", sources={\"prices\"})\n",
    "                assert \"tool_failed:get_price_history\" in failed_run[\"memory_entry\"][\"issues_encountered\"]\n",
    "                persisted = load_memory(root / \"other_memory.json\")\n",
    "                assert \"tool_failed:get_price_history\" in persisted[\"symbols\"][\"MSFT\"][-1][\"issues_encountered\"]\n",
    "                assert api.call_tool is broken_tool\n",
    "            finally:\n",
    "                api.call_tool = original_tool\n",
    "\n",
    "            # Even failed assembly must restore the original tool caller.\n",
    "            try:\n",
    "                with tool_boundary(api, ToolManager(api)):\n",
    "                    raise RuntimeError(\"simulated assembly failure\")\n",
    "            except RuntimeError:\n",
    "                pass\n",
    "            assert api.call_tool is original_tool\n",
    "\n",
    "            # Gate metadata describes each pass, not the accumulated shared log.\n",
    "            gate_start = len(api.GATE_LOG)\n",
    "            fresh_plan = create_research_plan(api, \"NVDA\", \"news\", [], [], {\"news\"})\n",
    "            first_bundle = collect_bundle(api, fresh_plan, False)\n",
    "            first_count = len(api.GATE_LOG) - gate_start\n",
    "            second_start = len(api.GATE_LOG)\n",
    "            second_bundle = collect_bundle(api, fresh_plan, False)\n",
    "            second_count = len(api.GATE_LOG) - second_start\n",
    "            assert first_count > 0 and second_count > 0\n",
    "            assert sum(g[\"checked\"] for g in first_bundle[\"pipeline_meta\"][\"gates\"].values()) == first_count\n",
    "            assert sum(g[\"checked\"] for g in second_bundle[\"pipeline_meta\"][\"gates\"].values()) == second_count\n",
    "            assert len(api.GATE_LOG) == gate_start + first_count + second_count\n",
    "\n",
    "            # Regression: word/digit equivalents pass; invented quantities still fail.\n",
    "            article_text = \"Nvidia commits $1bn to US science over the next five years\"\n",
    "            clean, issues = gate_extraction({\"key_figures\": [\"Commitment $1B over 5 years\"]}, article_text)\n",
    "            assert not issues and clean[\"key_figures\"]\n",
    "            clean, issues = gate_extraction({\"key_figures\": [\"Commitment $1B over 9 years\"]}, article_text)\n",
    "            assert issues and not clean[\"key_figures\"]\n",
    "\n",
    "            # An unresolved gate failure must block a rating even with a high score.\n",
    "            blocked_bundle = copy.deepcopy(before[\"bundle\"])\n",
    "            blocked_bundle[\"pipeline_meta\"][\"mode\"] = \"live\"\n",
    "            blocked_bundle[\"news\"][\"used_sample_data\"] = False\n",
    "            blocked_bundle[\"pipeline_meta\"][\"gate_failures\"] = [{\n",
    "                \"gate\": \"2_extract\", \"article_id\": \"test_article\", \"passed\": False,\n",
    "                \"issues\": [\"ungrounded figure dropped: invented quantity\"],\n",
    "            }]\n",
    "            blocked_eval = evaluate_research(blocked_bundle, before[\"analyses\"], before[\"plan\"])\n",
    "            blocked_eval[\"score\"] = 0.99\n",
    "            blocked_report = build_report(blocked_bundle, before[\"analyses\"], blocked_eval)\n",
    "            assert blocked_report[\"recommendation\"] == \"INSUFFICIENT EVIDENCE / NO RATING\"\n",
    "            assert \"test_article\" in blocked_report[\"markdown\"]\n",
    "            assert \"ungrounded figure dropped\" in blocked_report[\"markdown\"]\n",
    "\n",
    "            # Exercise the LLM contract with a stub; no real client or API call.\n",
    "            original_client = globals()[\"call_llm\"]\n",
    "            original_mode = globals()[\"LIVE\"], globals()[\"LLM_ENABLED\"]\n",
    "\n",
    "            # Verify that the research agent can handle LLM contract validation correctly, ensuring \n",
    "            # that valid candidates are accepted and invalid candidates are rejected based on the defined \n",
    "            # contract. This includes checking that extra model fields do not override extracted facts and \n",
    "            # that invalid model contracts trigger the appropriate fallback reason.\n",
    "            try:\n",
    "                globals()[\"LIVE\"], globals()[\"LLM_ENABLED\"] = True, True\n",
    "                valid_candidate = extractive_reasoning(\n",
    "                    \"market\", packet, evidence_catalog(\"market\", packet)\n",
    "                )\n",
    "                valid_candidate[\"sentiment_score\"] = (\n",
    "                    999  # Extra model fields must not override extracted facts.\n",
    "                )\n",
    "                globals()[\"call_llm\"] = lambda *args, **kwargs: copy.deepcopy(\n",
    "                    valid_candidate\n",
    "                )\n",
    "                llm_result = analyze_packet(\"market\", packet)\n",
    "                assert (\n",
    "                    llm_result[\"method\"] == \"llm\"\n",
    "                    and \"sentiment_score\" not in llm_result\n",
    "                )\n",
    "                bad_candidate = copy.deepcopy(valid_candidate)\n",
    "                bad_candidate[\"claims\"][0][\"value\"] = 999999\n",
    "                globals()[\"call_llm\"] = lambda *args, **kwargs: copy.deepcopy(\n",
    "                    bad_candidate\n",
    "                )\n",
    "                rejected = analyze_packet(\"market\", packet)\n",
    "                assert rejected[\"method\"] == \"rules\" and rejected[\n",
    "                    \"fallback_reason\"\n",
    "                ].startswith(\"Invalid model contract\")\n",
