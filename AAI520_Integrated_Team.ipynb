   "source": [
    "# Owner: Student 3 — Glen Salazar: analysis and quality\n",
    "def format_money(value):\n",
    "    return \"N/A\" if value is None else f\"${value:,.2f}\"\n",
    "\n",
    "\n",
    "def format_rate(value):\n",
    "    return \"not measured\" if value is None else f\"{value:.1%}\"\n",
    "\n",
    "\n",
    "# report builder :)\n",
    "def build_report(bundle: dict, analyses: dict, evaluation: dict) -> dict:\n",
    "    symbol = bundle.get(\"symbol\", \"UNKNOWN\")\n",
    "    company = bundle.get(\"company_name\") or symbol\n",
    "    earn = analyses.get(\"earnings\", {})\n",
    "    news = analyses.get(\"news\", {})\n",
    "    mkt = analyses.get(\"market\", {})\n",
    "\n",
    "    # Determine if the data is synthetic or from sample sources.\n",
    "    is_synthetic = bundle[\"pipeline_meta\"].get(\"mode\") == \"demo\" or bool(\n",
    "        bundle[\"news\"].get(\"used_sample_data\")\n",
    "    )\n",
    "    ret_1m = mkt.get(\"return_1m\") if mkt.get(\"return_1m\") is not None else None\n",
    "    sentiment = news.get(\"sentiment_score\")\n",
    "    quality = evaluation.get(\"score\", 0)\n",
    "    issues = evaluation.get(\"issues\", [])\n",
    "\n",
    "    # Check for missing or non-finite signals and any blocking issues.\n",
    "    missing_signals = any(\n",
    "        value is None or not math.isfinite(value)\n",
    "        for value in (ret_1m, sentiment)\n",
    "    )\n",
    "\n",
