    "# Owner: Student 1 — Hyunju Yu: data and NLP\n",
    "# [export] validate_ticker\n",
    "import difflib\n",
    "\n",
    "# Function to check if Yahoo Finance has data for a given ticker symbol.\n",
    "def _yahoo_has_data(sym: str) -> Optional[bool]:\n",
    "    # True = prices returned, False = empty, None = request raised. Note: when Yahoo rate-limits,\n",
    "    # yfinance often returns an EMPTY frame instead of raising, so False alone doesn't prove a bad ticker.\n",
    "    try:\n",
    "        return not yf.Ticker(sym).history(period=\"5d\").empty\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "# Function that validates whether the ticker symbol is valid or not.\n",
    "def validate_ticker(symbol: str) -> Dict[str, Any]:\n",
    "    if not LIVE:\n",
    "        normalized = (symbol or \"\").strip().upper().lstrip(\"$\")\n",
    "        valid = bool(re.fullmatch(r\"[A-Z0-9^][A-Z0-9.=^-]{0,11}\", normalized))\n",
    "        return {\n",
    "            \"symbol\": normalized,\n",
    "            \"valid\": valid,\n",
    "            \"suggestions\": [],\n",
    "            \"company_name\": \"SYNTHETIC COMPANY\",\n",
    "            \"note\": \"Fixture: format check only\",\n",
    "            \"input\": symbol,\n",
    "            \"checked_by\": [\"fixture_format\"],\n",
    "        }\n",
    "    \n",
    "    # Massage the ticker symbol text to upper case with no white space.\n",
    "    s = (symbol or \"\").upper().strip().lstrip(\"$\")\n",
    "    out = {\n",
    "        \"input\": symbol,\n",
    "        \"symbol\": s,\n",
    "        \"valid\": False,\n",
    "        \"company_name\": None,\n",
    "        \"checked_by\": [],\n",
    "        \"suggestions\": [],\n",
    "        \"note\": \"\",\n",
    "    }\n",
    "\n",
    "    # 1) Check for invalid characters in the ticker symbol\n",
    "    if not re.fullmatch(r\"[A-Z0-9^][A-Z0-9.=^-]{0,11}\", s):\n",
    "        out[\"note\"] = (\n",
    "            \"Invalid format. Use a ticker such as NVDA, BRK-B, SHOP.TO, ^GSPC.\"\n",
    "        )\n",
    "        return out\n",
    "\n",
    "    # 2) Yahoo Finance\n",
    "    yahoo = _yahoo_has_data(s)\n",
    "    if yahoo:\n",
    "        out[\"valid\"] = True\n",
    "        out[\"checked_by\"].append(\"yfinance\")\n",
    "        try:\n",
    "            out[\"company_name\"] = (yf.Ticker(s).info or {}).get(\"longName\")\n",
    "        except Exception:\n",
    "            pass\n",
    "\n",
    "    # 3) SEC ticker list (US listings only): confirms, names, and suggests\n",
    "    sec_ok = False\n",
    "    try:\n",
    "        _load_sec_tickers()\n",
    "        sec_ok = True\n",
    "        if s in _SEC_TITLES:\n",
    "            out[\"valid\"] = True\n",
    "            out[\"checked_by\"].append(\"sec\")\n",
    "            out[\"company_name\"] = out[\"company_name\"] or _SEC_TITLES[s].title()\n",
    "        else:\n",
    "            by_ticker = difflib.get_close_matches(\n",
    "                s, list(_SEC_TITLES), n=3, cutoff=0.6\n",
    "            )\n",
    "            title_map = {v.upper(): k for k, v in _SEC_TITLES.items()}\n",
    "            by_name = [\n",
    "                title_map[m]\n",
    "                for m in difflib.get_close_matches(\n",
    "                    s, list(title_map), n=3, cutoff=0.5\n",
    "                )\n",
    "            ]\n",
    "            by_prefix = [\n",
    "                k for k, v in _SEC_TITLES.items() if v.upper().startswith(s)\n",
    "            ][:3]\n",
    "            out[\"suggestions\"] = list(\n",
    "                dict.fromkeys(by_ticker + by_name + by_prefix)\n",
    "            )[:5]\n",
    "    except Exception as e:\n",
    "        out[\"note\"] += f\"SEC unreachable ({type(e).__name__}). \"\n",
    "    if out[\"valid\"]:\n",
    "        return out\n",
    "\n",
    "    # 4) Neither source confirmed it. Is that a bad ticker, or are the sources down?\n",
    "    yahoo_working = yahoo is False and _yahoo_has_data(\n",
    "        \"MSFT\"\n",
    "    )  # control ticker\n",
    "    non_us = any(\n",
    "        ch in s for ch in \".^=\"\n",
    "    )  # SEC can't judge foreign/index/FX tickers\n",
    "    if yahoo_working:\n",
    "        out[\"note\"] = (\n",
    "            f\"'{s}' returned no data from Yahoo Finance\"\n",
    "            + (\"\" if non_us else \" and is not in SEC EDGAR\")\n",
    "            + \".\"\n",
    "        )\n",
    "    elif sec_ok and not non_us:\n",
    "        out[\"note\"] = (\n",
    "            f\"'{s}' is not in SEC EDGAR and Yahoo is not responding. Likely a typo.\"\n",
    "        )\n",
    "    else:\n",
    "        out[\"valid\"] = None\n",
    "        out[\"note\"] = (\n",
    "            \"Could not verify (Yahoo not responding\"\n",
    "            + (\"\" if sec_ok else \", SEC unreachable\")\n",
    "            + \"). Continuing unverified. \"\n",
    "            + out[\"note\"]\n",
    "        )\n",
    "    return out\n"
   ]
