    "# Owner: Student 2 — Jim McCarthy: orchestration\n",
    "# Route the content of a data bundle into separate packets based on requested sources.\n",
    "def route_content(bundle: dict) -> dict:\n",
    "    common = {\n",
    "        \"symbol\": bundle[\"symbol\"],\n",
    "        \"generated_at\": bundle[\"generated_at\"],\n",
    "        \"sources\": bundle[\"sources\"],\n",
    "        \"sources_requested\": bundle[\"pipeline_meta\"][\"sources_requested\"],\n",
    "        \"used_sample_data\": bundle[\"news\"].get(\"used_sample_data\", False),\n",
    "    }\n",
    "    requested = set(common[\"sources_requested\"])\n",
    "    packets = {}\n",
    "\n",
    "    # Route the requested sources into separate packets (earnings, news, market) for \n",
    "    # easier downstream processing.\n",
    "    if requested & {\"fundamentals\", \"sec\"}:\n",
    "        packets[\"earnings\"] = {\n",
    "            **common,\n",
    "            \"fundamentals\": bundle[\"fundamentals\"],\n",
    "            \"filings\": bundle[\"filings\"],\n",
    "        }\n",
    "    if requested & {\"news\", \"alphavantage\"}:\n",
    "        packets[\"news\"] = {\n",
    "            **common,\n",
    "            \"news\": bundle[\"news\"],\n",
    "            \"external_sentiment\": bundle[\"external_sentiment\"],\n",
    "        }\n",
    "    if requested & {\"prices\", \"peers\", \"macro\"}:\n",
    "        packets[\"market\"] = {\n",
    "            **common,\n",
    "            \"market\": bundle[\"market\"],\n",
    "            \"macro\": bundle[\"macro\"],\n",
    "        }\n",
    "\n",
    "    # Return the routed packets for downstream processing.\n",
    "    return packets\n",
    "\n",
    "# Validate the structure and content of an evaluation result returned by the evaluator.\n",
    "def validate_evaluation(value: dict) -> dict:\n",
    "    if not isinstance(value, dict):\n",
    "        raise TypeError(\"Evaluator must return a dict\")\n",
    "    score = value.get(\"score\")\n",
    "\n",
    "    # Ensure the score is a valid number between 0 and 1.\n",
    "    if (\n",
    "        isinstance(score, bool)\n",
    "        or not isinstance(score, (int, float))\n",
    "        or not 0 <= score <= 1\n",
    "    ):\n",
    "        raise ValueError(\"Evaluator score must be a finite number from 0 to 1\")\n",
    "\n",
    "    # Ensure the issues field is a list of strings.\n",
    "    if not isinstance(value.get(\"issues\"), list) or not all(\n",
    "        isinstance(x, str) for x in value[\"issues\"]\n",
    "    ):\n",
    "        raise ValueError(\"Evaluator issues must be a list of strings\")\n",
    "\n",
    "    # Ensure the retry_news field is a boolean indicating whether to retry news collection.\n",
    "    if not isinstance(value.get(\"retry_news\"), bool):\n",
    "        raise ValueError(\"Evaluator retry_news must be boolean\")\n",
    "    return value\n"
   ]
