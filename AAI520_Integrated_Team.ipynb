    "### Step 7.2 — Financial news — Yahoo Finance, Google News RSS, NewsAPI\n",
    "\n",
    "Three sources, all normalized into `NewsArticle`. Yahoo changed its news JSON format in 2025, so `_parse_yf_news` handles both the old flat format and the new nested `content` format."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "team-revised-016",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Owner: Student 1 — Hyunju Yu: data and NLP\n",
    "# [export] tools_news\n",
    "\n",
    "# Convert a timestamp (int, float, or string) to an ISO-8601 formatted string in UTC. \n",
    "# Returns None for invalid or empty inputs.\n",
    "def _to_iso(ts) -> Optional[str]:\n",
    "    if ts is None or ts == \"\":\n",
    "        return None\n",
    "    try:\n",
    "        if isinstance(ts, (int, float)):\n",
    "            return datetime.fromtimestamp(ts, tz=timezone.utc).isoformat()\n",
    "        return pd.to_datetime(ts, utc=True).isoformat()\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "# Parse a news item from Yahoo Finance into a NewsArticle dataclass, extracting relevant \n",
    "# fields such as title, URL, publisher, publication date, and summary. Returns None if \n",
    "# the title is missing.\n",
    "def _parse_yf_news(item: Dict[str, Any]) -> Optional[NewsArticle]:\n",
    "    c = item.get(\n",
    "        \"content\", item\n",
    "    )  # new format nests everything under \"content\"\n",
    "    title = c.get(\"title\") or \"\"\n",
    "    if not title:\n",
    "        return None\n",
    "\n",
    "    # Extract the URL, publisher, publication date, and summary from the news item, using\n",
    "    # various fallback options to ensure that the fields are populated even if some data is \n",
    "    # missing.\n",
    "    url = (\n",
    "        (c.get(\"canonicalUrl\") or {}).get(\"url\")\n",
    "        or (c.get(\"clickThroughUrl\") or {}).get(\"url\")\n",
    "        or c.get(\"link\")\n",
    "        or \"\"\n",
    "    )\n",
    "    publisher = (\n",
    "        (c.get(\"provider\") or {}).get(\"displayName\")\n",
    "        or c.get(\"publisher\")\n",
    "        or \"Yahoo Finance\"\n",
    "    )\n",
    "    published = _to_iso(\n",
    "        c.get(\"pubDate\")\n",
    "        or c.get(\"displayTime\")\n",
    "        or c.get(\"providerPublishTime\")\n",
    "    )\n",
    "    summary = c.get(\"summary\") or c.get(\"description\") or \"\"\n",
    "\n",
    "    # Return a NewsArticle instance with the extracted information, generating a unique ID based\n",
    "    # on the title and URL.\n",
    "    return NewsArticle(\n",
    "        NewsArticle.make_id(title, url),\n",
    "        title,\n",
    "        summary,\n",
    "        url,\n",
    "        publisher,\n",
    "        published,\n",
    "        \"yfinance\",\n",
    "    )\n",
    "\n",
    "# Function to fetch news articles for a given stock symbol using the yfinance library. It retrieves\n",
    "# a specified number of news articles (up to the limit) and returns them in a structured\n",
    "# format, including success status, source, data, and any error messages.\n",
    "def fetch_news_yfinance(symbol: str, limit: int = 30) -> Dict[str, Any]:\n",
    "    try:\n",
    "        t = yf.Ticker(symbol)\n",
    "        try:\n",
    "            raw = t.get_news(count=limit)\n",
    "        except TypeError:\n",
    "            raw = t.news\n",
    "        arts = [a for a in (_parse_yf_news(x) for x in (raw or [])) if a]\n",
    "        return tool_result(\n",
    "            bool(arts),\n",
    "            \"yfinance_news\",\n",
    "            data=arts,\n",
    "            error=None if arts else \"No articles returned\",\n",
    "        )\n",
    "    except Exception as e:\n",
    "        return tool_result(\n",
    "            False, \"yfinance_news\", data=[], error=f\"{type(e).__name__}: {e}\"\n",
    "        )\n",
    "\n",
    "# Function to fetch news articles from Google News RSS feed based on a query string. It retrieves\n",
    "# a specified number of articles (up to the limit) published within a certain number of days. \n",
    "# The function returns the articles in a structured format, including success status, source,\n",
    "# data, and any error messages.\n",
    "def fetch_news_google_rss(\n",
    "    query: str, limit: int = 30, days: int = 14\n",
    ") -> Dict[str, Any]:\n",
    "    # Free, keyless backup source. Query example: \"NVIDIA stock\" or \"NVDA\".\n",
    "    try:\n",
    "        # Build the URL for the google RSS feed for the listed stock.\n",
    "        url = f\"https://news.google.com/rss/search?q={requests.utils.quote(query)}+when:{max(1, min(int(days), 30))}d&hl=en-US&gl=US&ceid=US:en\"\n",
    "        feed = feedparser.parse(url)\n",
    "        arts = []\n",
    "        \n",
    "        # Build the article list from the returned RSS feed\n",
    "        for e in feed.entries[:limit]:\n",
    "            title = e.get(\"title\", \"\")\n",
    "            publisher = (e.get(\"source\") or {}).get(\"title\", \"Google News\")\n",
    "            # Google appends \" - Publisher\" to titles; strip it\n",
    "            if publisher and title.endswith(f\" - {publisher}\"):\n",
    "                title = title[: -len(publisher) - 3]\n",
    "\n",
    "            # Create a NewsArticle instance for each entry in the feed, extracting relevant fields such as\n",
    "            # title, summary, URL, publisher, and publication date. The unique ID is generated\n",
    "            # based on the title and URL.\n",
    "            arts.append(\n",
    "                NewsArticle(\n",
    "                    NewsArticle.make_id(title, e.get(\"link\", \"\")),\n",
    "                    title,\n",
    "                    e.get(\"summary\", \"\"),\n",
    "                    e.get(\"link\", \"\"),\n",
    "                    publisher,\n",
    "                    _to_iso(e.get(\"published\")),\n",
    "                    \"google_rss\",\n",
    "                )\n",
    "            )\n",
    "\n",
    "        return tool_result(\n",
    "            bool(arts),\n",
    "            \"google_rss\",\n",
    "            data=arts,\n",
    "            error=None if arts else \"Empty feed\",\n",
    "        )\n",
    "    except Exception as e:\n",
    "        return tool_result(\n",
    "            False, \"google_rss\", data=[], error=f\"{type(e).__name__}: {e}\"\n",
    "        )\n",
    "\n",
    "# Function to fetch news articles from the NewsAPI service based on a query string. It retrieves\n",
    "# a specified number of articles (up to the limit) published within a certain number of days. \n",
    "# The function returns the articles in a structured format, including success status, source,\n",
    "# data, and any error messages.\n",
    "def fetch_news_newsapi(\n",
    "    query: str, days: int = 14, limit: int = 30\n",
    ") -> Dict[str, Any]:\n",
    "    key = CONFIG[\"NEWSAPI_KEY\"]\n",
    "    if not key:\n",
    "        return tool_result(\n",
    "            False, \"newsapi\", data=[], error=\"NEWSAPI_KEY not set\"\n",
    "        )\n",
    "    try:\n",
    "        frm = (\n",
    "            datetime.now(timezone.utc) - timedelta(days=min(days, 29))\n",
    "        ).strftime(\n",
    "            \"%Y-%m-%d\"\n",
    "        )  # free tier = 30 days\n",
    "        # Make the API request to NewsAPI with the specified query and parameters.\n",
    "        r = requests.get(\n",
    "            \"https://newsapi.org/v2/everything\",\n",
    "            timeout=15,\n",
    "            params={\n",
    "                \"q\": query,\n",
    "                \"from\": frm,\n",
    "                \"language\": \"en\",\n",
    "                \"sortBy\": \"relevancy\",\n",
    "                \"pageSize\": min(limit, 100),\n",
    "                \"apiKey\": key,\n",
    "            },\n",
    "        )\n",
    "        # Raise an exception if the API request was not successful.\n",
    "        r.raise_for_status()\n",
    "\n",
    "        # Parse the JSON response from the NewsAPI request.\n",
    "        arts = [\n",
    "            NewsArticle(\n",
    "                NewsArticle.make_id(a[\"title\"] or \"\", a[\"url\"] or \"\"),\n",
    "                a.get(\"title\") or \"\",\n",
    "                a.get(\"description\") or \"\",\n",
    "                a.get(\"url\") or \"\",\n",
    "                (a.get(\"source\") or {}).get(\"name\", \"NewsAPI\"),\n",
    "                _to_iso(a.get(\"publishedAt\")),\n",
    "                \"newsapi\",\n",
    "                content=a.get(\"content\") or \"\",\n",
    "            )\n",
    "            for a in r.json().get(\"articles\", [])\n",
    "            if a.get(\"title\") and a[\"title\"] != \"[Removed]\"\n",
    "        ]\n",
    "        return tool_result(\n",
    "            bool(arts),\n",
    "            \"newsapi\",\n",
    "            data=arts,\n",
    "            error=None if arts else \"No articles\",\n",
    "        )\n",
    "    except Exception as e:\n",
    "        return tool_result(\n",
    "            False, \"newsapi\", data=[], error=f\"{type(e).__name__}: {e}\"\n",
    "        )\n"
   ]
