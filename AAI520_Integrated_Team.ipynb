    "                            \"market\", []\n",
    "                        )\n",
    "                    )\n",
    "                    or \"Resolved\",\n",
    "                    \"Diagnostic score\": snapshot[\"evaluation\"][\"score\"],\n",
    "                }\n",
    "            )\n",
    "\n",
    "        # Prepare a summary of the memory-informed runs, including prior records, initial window, data passes, \n",
    "        # first-pass drafts, and lessons used.\n",
    "        memory_rows = []\n",
    "        for label, run in [\n",
