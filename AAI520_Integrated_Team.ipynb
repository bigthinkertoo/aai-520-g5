    "# Owner: Shared integration and validation\n",
    "# AI-assisted excerpt judgments; students have not reviewed these labels.\n",
    "claim_examples = [\n",
    "    {\"source_excerpt\": \"Nvidia commits $1bn to US science over the next five years\",\n",
    "     \"claim\": \"The announced commitment is $1bn over 5 years.\",\n",
    "     \"judgment\": \"supported\", \"rationale\": \"The amount and duration match the title; five and 5 are equivalent.\"},\n",
    "    {\"source_excerpt\": \"Nvidia commits $1bn to US science over the next five years\",\n",
    "     \"claim\": \"The announced commitment is $1bn over 9 years.\",\n",
    "     \"judgment\": \"contradicted\", \"rationale\": \"The title specifies five years, not nine.\"},\n",
    "    {\"source_excerpt\": \"Nvidia commits $1bn to US science over the next five years\",\n",
    "     \"claim\": \"The commitment guarantees higher shareholder returns.\",\n",
    "     \"judgment\": \"unsupported\", \"rationale\": \"The title states a commitment, not a guaranteed financial outcome.\"},\n",
    "    {\"source_excerpt\": \"SYNTHETIC example: forward P/E is 20; revenue growth is 10%.\",\n",
    "     \"claim\": \"Forward P/E is 20.\", \"judgment\": \"supported\",\n",
    "     \"rationale\": \"Directly stated in the supplied synthetic excerpt.\"},\n",
    "    {\"source_excerpt\": \"SYNTHETIC example: forward P/E is 20; revenue growth is 10%.\",\n",
    "     \"claim\": \"The company is undervalued relative to peers.\", \"judgment\": \"unsupported\",\n",
    "     \"rationale\": \"No peer valuations or valuation model are supplied.\"},\n",
    "]\n",
    "display(Markdown(\"### AI-assisted excerpt review (selected examples; no human labels)\"))\n",
    "display(pd.DataFrame(claim_examples))\n",
    "\n",
    "pending_reviews = []\n",
    "for role, analysis in first[\"analyses\"].items():\n",
    "    for claim in analysis.get(\"claims\", [])[:2]:\n",
    "        pending_reviews.append({\"role\": role, \"evidence_id\": claim[\"evidence_id\"],\n",
    "            \"copied_value\": claim[\"value\"], \"interpretation\": claim[\"interpretation\"],\n",
    "            \"student_judgment\": \"PENDING\", \"student_rationale\": \"PENDING\"})\n",
    "display(Markdown(\"### Current-run claims awaiting student source review\"))\n",
    "display(pd.DataFrame(pending_reviews))\n",
    "\n",
    "def compare_learning_on_fixed_evidence(run, run_live=False):\n",
    "    if run_live and (not LIVE or not LLM_ENABLED or run[\"synthetic\"]):\n",
    "        raise ValueError(\"Live comparison requires live mode, an available model and non-synthetic evidence\")\n",
    "    packets = route_content(run[\"bundle\"])\n",
    "    lessons = run[\"memory_entry\"].get(\"analysis_lessons\", [])\n",
    "    rows = []\n",
    "    # run_live=False explicitly bypasses model calls, even in a live notebook.\n",
    "    for label, condition_lessons in [(\"No prior lessons\", []), (\"Saved lessons\", lessons)]:\n",
    "        analyses = {}\n",
    "        for role, packet in packets.items():\n",
    "            if run_live:\n",
    "                analyses[role] = analyze_packet(role, copy.deepcopy(packet), lessons=condition_lessons)\n",
    "            else:\n",
    "                analyses[role] = {**extract_packet(role, packet),\n",
    "                    **extractive_reasoning(role, packet, evidence_catalog(role, packet)),\n",
    "                    \"method\": \"rules\", \"lessons_used\": list(condition_lessons)}\n",
    "        audit = analysis_audit(run[\"bundle\"], analyses)\n",
    "        rows.append({\"condition\": label, \"lessons_supplied\": \", \".join(condition_lessons) or \"None\",\n",
    "            \"methods\": \", \".join(sorted({a[\"method\"] for a in analyses.values()})),\n",
    "            \"analysis_diagnostic_score\": audit[\"score\"], \"flagged_issues\": len(audit[\"issues\"]),\n",
    "            \"scope\": \"live specialist calls, fixed evidence\" if run_live else \"deterministic fixed-evidence comparison\"})\n",
    "    return rows\n",
    "\n",
    "RUN_LIVE_LEARNING_CHECK = True  # Enable explicitly to permit paid specialist calls.\n",
    "learning_comparison = compare_learning_on_fixed_evidence(first, run_live=RUN_LIVE_LEARNING_CHECK)\n",
    "display(pd.DataFrame(learning_comparison))\n",
    "print(\"Comparison is descriptive; equal scores or rule fallbacks do not demonstrate live learning.\")\n"
   ]
