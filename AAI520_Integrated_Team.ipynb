    "                globals()[\"call_llm\"] = original_client\n",
    "                globals()[\"LIVE\"], globals()[\"LLM_ENABLED\"] = original_mode\n",
    "\n",
    "        # Verify that the research agent can handle LLM contract validation correctly, ensuring that valid \n",
    "        # candidates are accepted and invalid candidates are rejected based on the defined contract. This \n",
    "        # includes checking that extra model fields do not override extracted facts and that invalid model \n",
