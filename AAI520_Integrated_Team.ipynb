    "# Owner: Shared setup\n",
    "# Pull environment variables and set up initial configuration\n",
    "LIVE = True if os.environ.get(\"LIVE\") == \"1\" else False\n",
    "print(f\"Running in {'LIVE' if LIVE else 'DEMO'} mode...\")\n",
