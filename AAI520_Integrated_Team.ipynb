   "source": [
    "### Step 7.4 — Company filings — SEC EDGAR\n",
    "\n",
    "EDGAR is free but **requires a descriptive `User-Agent`** with contact info, and limits you to 10 requests/second.\n",
    "We map ticker → CIK, list recent 10-K / 10-Q / 8-K filings, and pull headline XBRL facts (reported revenue, net income) as an independent check on the Yahoo numbers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "team-revised-020",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Owner: Student 1 — Hyunju Yu: data and NLP\n",
    "# [export] tools_sec\n",
    "_SEC_HEADERS = {\n",
    "    \"User-Agent\": CONFIG[\"SEC_USER_AGENT\"],\n",
    "    \"Accept-Encoding\": \"gzip, deflate\",\n",
    "}\n",
    "_CIK_CACHE: Dict[str, str] = {}\n",
    "_SEC_TITLES: Dict[str, str] = (\n",
    "    {}\n",
    ")  # ticker -> company name, reused by validate_ticker()\n",
    "\n",
    "# Load the SEC tickers and their corresponding CIKs into a cache for quick lookup. This \n",
    "# function fetches the data from the SEC's company tickers JSON file and populates the \n",
    "# _CIK_CACHE and _SEC_TITLES dictionaries. It raises a ValueError if the SEC_USER_AGENT \n",
    "# is not set.\n",
    "def _load_sec_tickers():\n",
    "    if not CONFIG[\"SEC_USER_AGENT\"]:\n",
    "        raise ValueError(\"Set SEC_USER_AGENT to a project/contact email\")\n",
    "    if not _CIK_CACHE:\n",
    "        r = requests.get(\n",
    "            \"https://www.sec.gov/files/company_tickers.json\",\n",
    "            headers=_SEC_HEADERS,\n",
    "            timeout=15,\n",
    "        )\n",
    "        r.raise_for_status()\n",
    "        for row in r.json().values():\n",
    "            _CIK_CACHE[row[\"ticker\"].upper()] = str(row[\"cik_str\"]).zfill(10)\n",
    "            _SEC_TITLES[row[\"ticker\"].upper()] = row[\"title\"]\n",
    "\n",
    "# Function to retrieve the Central Index Key (CIK) for a given stock symbol. The CIK is \n",
    "# a unique identifier assigned by the SEC to each company that files with them. This \n",
    "# function loads the SEC tickers into a cache if they haven't been loaded yet and returns \n",
    "# the CIK for the provided symbol, or None if the symbol is not found.\n",
    "def get_cik(symbol: str) -> Optional[str]:\n",
    "    _load_sec_tickers()\n",
    "    return _CIK_CACHE.get(symbol.upper())\n",
    "\n",
    "# Function to retrieve recent SEC filings for a given stock symbol. It fetches the filings\n",
    "# from the SEC's EDGAR database and returns a structured result containing the filings' details,\n",
    "# including form type, filing date, report date, description, and URL. The function allows\n",
    "# filtering by specific form types and limits the number of filings returned.\n",
    "def get_sec_filings(\n",
    "    symbol: str, forms: Optional[List[str]] = None, limit: int = 10\n",
    ") -> Dict[str, Any]:\n",
    "    try:\n",
    "        cik = get_cik(symbol)\n",
    "        if not cik:\n",
    "            return tool_result(\n",
    "                False,\n",
    "                \"sec_edgar\",\n",
    "                data=[],\n",
    "                error=f\"No CIK for {symbol} (non-US listing?)\",\n",
    "            )\n",
    "        r = requests.get(\n",
    "            f\"https://data.sec.gov/submissions/CIK{cik}.json\",\n",
    "            headers=_SEC_HEADERS,\n",
    "            timeout=15,\n",
    "        )\n",
    "        # Raise an exception if the SEC filings request was not successful.\n",
    "        r.raise_for_status()\n",
    "        recent = r.json()[\"filings\"][\"recent\"]\n",
    "\n",
    "        # Extract the recent filings from the SEC response.\n",
    "        rows = []\n",
    "        for i, form in enumerate(recent[\"form\"]):\n",
    "            if form in (forms or [\"10-K\", \"10-Q\", \"8-K\"]):\n",
    "                acc = recent[\"accessionNumber\"][i].replace(\"-\", \"\")\n",
    "                rows.append(\n",
    "                    {\n",
    "                        \"form\": form,\n",
    "                        \"filing_date\": recent[\"filingDate\"][i],\n",
    "                        \"report_date\": recent[\"reportDate\"][i],\n",
    "                        \"description\": recent.get(\n",
    "                            \"primaryDocDescription\", [\"\"] * (i + 1)\n",
    "                        )[i],\n",
    "                        \"url\": f\"https://www.sec.gov/Archives/edgar/data/{int(cik)}/{acc}/{recent['primaryDocument'][i]}\",\n",
    "                    }\n",
    "                )\n",
    "            if len(rows) >= limit:\n",
    "                break\n",
    "        return tool_result(bool(rows), \"sec_edgar\", data=rows, cik=cik)\n",
    "    except Exception as e:\n",
    "        return tool_result(\n",
    "            False, \"sec_edgar\", data=[], error=f\"{type(e).__name__}: {e}\"\n",
    "        )\n",
    "\n",
    "# Function to retrieve key financial facts from the SEC's XBRL data for a given stock symbol.\n",
    "def get_sec_key_facts(symbol: str) -> Dict[str, Any]:\n",
    "    # Latest annual (10-K) values for a few XBRL tags, straight from the filings.\n",
    "    tags = {\n",
    "        \"Revenues\": [\n",
    "            \"Revenues\",\n",
    "            \"RevenueFromContractWithCustomerExcludingAssessedTax\",\n",
    "        ],\n",
    "        \"NetIncomeLoss\": [\"NetIncomeLoss\"],\n",
    "        \"Assets\": [\"Assets\"],\n",
    "        \"EPS_Diluted\": [\"EarningsPerShareDiluted\"],\n",
    "    }\n",
    "    try:\n",
    "        # Get the CIK for the provided stock symbol. If the CIK is not found, return a failure result.\n",
    "        cik = get_cik(symbol)\n",
    "        if not cik:\n",
    "            return tool_result(False, \"sec_edgar_xbrl\", error=\"No CIK\")\n",
    "\n",
    "        # Fetch the XBRL company facts JSON data from the SEC's API using the CIK. The function extracts\n",
    "        # the relevant financial facts for the specified tags, focusing on the latest annual (10-K\n",
    "        # filings) values. It returns a structured result containing the extracted financial data or\n",
    "        # an error message if the retrieval fails.\n",
    "        r = requests.get(\n",
    "            f\"https://data.sec.gov/api/xbrl/companyfacts/CIK{cik}.json\",\n",
    "            headers=_SEC_HEADERS,\n",
    "            timeout=20,\n",
    "        )\n",
    "        r.raise_for_status()\n",
    "\n",
    "        # Extract the GAAP facts from the JSON response and initialize an output dictionary to store the\n",
    "        # extracted financial data.\n",
    "        gaap = r.json()[\"facts\"].get(\"us-gaap\", {})\n",
    "        out = {}\n",
    "\n",
    "        # Iterate through the specified tags and their corresponding candidates to extract the latest \n",
    "        # annual values from the XBRL data. The function checks for the presence of the tags in the GAAP \n",
    "        # data, filters for annual filings, and selects the latest value based on the end date and filing \n",
    "        # date. The extracted values are stored in the output dictionary, which is returned as part of \n",
    "        # the tool result.\n",
    "        for label, candidates in tags.items():\n",
    "            for tag in candidates:\n",
    "                if tag not in gaap:\n",
    "                    continue\n",
    "                units = next(iter(gaap[tag][\"units\"].values()))\n",
    "                annual = [\n",
    "                    u\n",
    "                    for u in units\n",
    "                    if u.get(\"form\") == \"10-K\" and u.get(\"fp\") == \"FY\"\n",
    "                ]\n",
    "                if annual:\n",
    "                    if label != \"Assets\":\n",
    "                        annual = [\n",
    "                            u\n",
    "                            for u in annual\n",
    "                            if u.get(\"start\")\n",
    "                            and 300\n",
    "                            <= (\n",
    "                                pd.Timestamp(u[\"end\"])\n",
    "                                - pd.Timestamp(u[\"start\"])\n",
    "                            ).days\n",
    "                            <= 400\n",
    "                        ]\n",
    "                    if not annual:\n",
    "                        continue\n",
    "                    latest = max(\n",
    "                        annual, key=lambda u: (u[\"end\"], u.get(\"filed\", \"\"))\n",
    "                    )\n",
    "                    out[label] = {\n",
    "                        \"value\": latest[\"val\"],\n",
    "                        \"period_end\": latest[\"end\"],\n",
    "                        \"filed\": latest[\"filed\"],\n",
    "                    }\n",
    "                    break\n",
    "        return tool_result(bool(out), \"sec_edgar_xbrl\", data=out)\n",
    "    except Exception as e:\n",
    "        return tool_result(\n",
    "            False, \"sec_edgar_xbrl\", error=f\"{type(e).__name__}: {e}\"\n",
    "        )\n"
   ]
