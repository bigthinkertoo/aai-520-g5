    "\n",
    "# Student 3: retain the original extractive fields and add grounded reasoning.\n",
    "def evidence_catalog(role: str, packet: dict) -> dict:\n",
    "    \"\"\"Stable paths identify observed values; IDs are not proof of semantics.\"\"\"\n",
    "    catalog = {}\n",
    "\n",
    "    def visit(value, path):\n",
    "        if isinstance(value, dict):\n",
    "            for key, item in value.items():\n",
    "                visit(item, f\"{path}.{key}\" if path else str(key))\n",
    "        elif isinstance(value, list):\n",
    "            for index, item in enumerate(value):\n",
    "                visit(item, f\"{path}.{index}\")\n",
    "        elif value is not None and isinstance(value, (str, int, float, bool)):\n",
    "            if not isinstance(value, float) or math.isfinite(value):\n",
    "                catalog[path] = json_safe(value)\n",
    "\n",
    "    for name in {\n",
    "        \"earnings\": (\"fundamentals\", \"filings\"),\n",
    "        \"news\": (\"news\", \"external_sentiment\"),\n",
    "        \"market\": (\"market\", \"macro\"),\n",
    "    }[role]:\n",
    "        visit(packet.get(name), name)\n",
    "    return catalog\n",
    "\n",
    "\n",
    "def expected_momentum(packet: dict) -> str:\n",
    "    value = (packet.get(\"market\", {}).get(\"price_summary\") or {}).get(\n",
    "        \"return_1m\"\n",
    "    )\n",
    "    if value is None:\n",
    "        return \"unknown\"\n",
    "    return \"negative\" if value < 0 else \"positive\" if value > 0 else \"flat\"\n",
    "\n",
    "\n",
    "def extractive_reasoning(role: str, packet: dict, catalog: dict) -> dict:\n",
    "    \"\"\"Deterministic reasoning remains explicit when an LLM is unavailable.\"\"\"\n",
    "    claims = []\n",
    "\n",
    "    def claim(key, text):\n",
    "        if key in catalog:\n",
    "            claims.append(\n",
    "                {\n",
    "                    \"evidence_id\": key,\n",
    "                    \"value\": catalog[key],\n",
    "                    \"interpretation\": text,\n",
    "                }\n",
    "            )\n",
    "\n",
    "    limitations = [\n",
    "        \"Evidence references and numeric checks do not verify every semantic claim.\"\n",
    "    ]\n",
    "    direction = (\n",
    "        expected_momentum(packet) if role == \"market\" else \"not_applicable\"\n",
    "    )\n",
    "    if role == \"market\":\n",
    "        value = catalog.get(\"market.price_summary.return_1m\")\n",
    "        monthly = \"not available\" if value is None else f\"{value:+.1%}\"\n",
    "        summary = f\"One-month return is {monthly}; momentum is {direction}.\"\n",
    "        claim(\n",
    "            \"market.price_summary.return_1m\",\n",
    "            f\"Monthly momentum is {direction}.\",\n",
    "        )\n",
    "        claim(\n",
    "            \"market.price_summary.rsi_14\",\n",
    "            \"RSI provides a technical signal, not a guarantee of reversal.\",\n",
    "        )\n",
    "        claim(\n",
    "            \"market.price_summary.last_close\",\n",
    "            \"Latest available closing price; check its date before use.\",\n",
    "        )\n",
    "        risks = [\n",
    "            \"Momentum can reverse; macro observations may have different release dates.\"\n",
    "        ]\n",
    "    elif role == \"earnings\":\n",
    "        summary = \"Assess valuation alongside growth and profitability; align fiscal periods before comparing sources.\"\n",
    "        claim(\n",
    "            \"fundamentals.company_info.forwardPE\",\n",
    "            \"Forward P/E depends on earnings estimates and needs peer context.\",\n",
    "        )\n",
    "        claim(\n",
    "            \"fundamentals.company_info.revenueGrowth\",\n",
    "            \"Reported growth provides context, not a forecast.\",\n",
    "        )\n",
    "        claim(\n",
    "            \"fundamentals.company_info.profitMargins\",\n",
    "            \"Profit margin describes current profitability.\",\n",
    "        )\n",
    "        claim(\n",
    "            \"fundamentals.sec_key_facts.Revenues.value\",\n",
    "            \"Annual XBRL revenue requires a matching period and unit.\",\n",
    "        )\n",
    "        risks = [\n",
    "            \"Forward estimates can change; source periods and units may differ.\"\n",
    "        ]\n",
    "        if (\n",
    "            not (packet.get(\"fundamentals\", {}).get(\"sec_key_facts\") or {})\n",
    "            .get(\"Revenues\", {})\n",
    "            .get(\"period_end\")\n",
    "        ):\n",
    "            limitations.append(\"SEC revenue period is unavailable.\")\n",
    "    else:\n",
    "        summary = \"News catalysts and risks reflect the available snippets; sentiment alone does not establish a rating.\"\n",
    "        claim(\n",
    "            \"news.aggregate.weighted_score\",\n",
    "            \"Aggregate news sentiment is an input, not investment confidence.\",\n",
    "        )\n",
    "        claim(\n",
    "            \"news.aggregate.n_articles\",\n",
    "            \"Article count describes coverage, not factual accuracy.\",\n",
    "        )\n",
    "        for i, article in enumerate(\n",
    "            packet.get(\"news\", {}).get(\"articles\", [])[:3]\n",
    "        ):\n",
    "            claim(\n",
    "                f\"news.articles.{i}.summary\",\n",
    "                \"Article-level summary retained as evidence; review its original source.\",\n",
    "            )\n",
    "        risks = list(\n",
    "            packet.get(\"news\", {}).get(\"digest\", {}).get(\"top_risks\")\n",
    "            or [\"Limited news coverage may omit material risks.\"]\n",
    "        )\n",
    "        limitations.append(\n",
    "            \"News is headline/snippet based and may omit material context.\"\n",
    "        )\n",
    "    return {\n",
    "        \"summary\": summary,\n",
    "        \"claims\": claims,\n",
    "        \"risks\": risks,\n",
    "        \"limitations\": limitations,\n",
    "        \"momentum_direction\": direction,\n",
    "    }\n",
    "\n",
    "\n",
    "def reasoning_issues(role: str, result: dict, packet: dict) -> list[str]:\n",
    "    \"\"\"Check declared values, references and momentum; not semantic accuracy.\"\"\"\n",
    "    catalog = evidence_catalog(role, packet)\n",
    "    problems = []\n",
    "    if not isinstance(result, dict):\n",
    "        return [\"analysis_not_object\"]\n",
    "    if (\n",
    "        not isinstance(result.get(\"summary\"), str)\n",
    "        or not result[\"summary\"].strip()\n",
    "    ):\n",
    "        problems.append(\"missing_summary\")\n",
    "    for key in (\"risks\", \"limitations\"):\n",
    "        if (\n",
    "            not isinstance(result.get(key), list)\n",
    "            or not result[key]\n",
    "            or not all(isinstance(x, str) for x in result[key])\n",
    "        ):\n",
    "            problems.append(\"missing_\" + key)\n",
    "    claims = result.get(\"claims\")\n",
    "    if not isinstance(claims, list) or not claims:\n",
    "        problems.append(\"missing_evidence_claims\")\n",
    "        claims = []\n",
    "    for item in claims:\n",
    "        if not isinstance(item, dict):\n",
    "            problems.append(\"malformed_claim\")\n",
    "            continue\n",
    "        key = item.get(\"evidence_id\")\n",
    "        if not isinstance(key, str) or key not in catalog:\n",
    "            problems.append(\"unknown_evidence_reference\")\n",
    "            continue\n",
    "        # Match the copied value as well as the cited field.\n",
    "        if (\n",
    "            type(item.get(\"value\")) is not type(catalog[key])\n",
    "            or item.get(\"value\") != catalog[key]\n",
    "        ):\n",
    "            problems.append(\"claim_value_mismatch\")\n",
    "        text = item.get(\"interpretation\")\n",
    "        if not isinstance(text, str) or not text.strip():\n",
    "            problems.append(\"missing_interpretation\")\n",
    "        elif _numbers(text) - _numbers(str(catalog[key])):\n",
    "            problems.append(\"unsupported_numeric_interpretation\")\n",
    "    if role == \"market\":\n",
    "        expected = expected_momentum(packet)\n",
    "        if result.get(\"momentum_direction\") != expected:\n",
    "            problems.append(\"contradictory_momentum\")\n",
    "        if expected != \"unknown\" and not any(\n",
    "            isinstance(c, dict)\n",
    "            and c.get(\"evidence_id\") == \"market.price_summary.return_1m\"\n",
    "            for c in claims\n",
    "        ):\n",
    "            problems.append(\"missing_monthly_return\")\n",
    "        if (\n",
    "            expected == \"negative\"\n",
    "            and \"negative\" not in str(result.get(\"summary\", \"\")).lower()\n",
    "        ):\n",
    "            problems.append(\"summary_omits_negative_momentum\")\n",
    "    return list(dict.fromkeys(problems))\n",
    "\n"
   ]
  },
