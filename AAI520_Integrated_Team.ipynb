    "                    \"Initial window (days)\": run[\"attempts\"][0][\"plan\"][\n",
    "                        \"lookback_days\"\n",
    "                    ],\n",
    "                    \"Data passes\": len(run[\"attempts\"]),\n",
    "                    \"First-pass drafts\": len(\n",
    "                        run[\"attempts\"][0][\"analysis_revisions\"]\n",
